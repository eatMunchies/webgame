# emsdk checkout with Emscripten 3.1.74 installed and activated. Required for `just build-web`.
#EMSDK=/path/to/emsdk-directory

# Specify your Godot 4.7 binary. This is only needed if your Godot 4.7
# installation is not in your PATH. If you have Godot 4.7 installed and it is
# in your PATH, you can leave this commented out.
#GODOT=/path/to/godot
