[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hud/chat_panel.gd" id="1_chat"]

[node name="ChatPanel" type="PanelContainer"]
size_flags_vertical = 3
script = ExtResource("1_chat")

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Log" type="RichTextLabel" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
scroll_following = true

[node name="InputRow" type="HBoxContainer" parent="Rows"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Input" type="LineEdit" parent="Rows/InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Enter to chat"
max_length = 1600

[node name="SendButton" type="Button" parent="Rows/InputRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Send"
