[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hud/roster.gd" id="1_roster"]

[node name="Roster" type="PanelContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("1_roster")

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Prompt" type="Label" parent="Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"Title"
autowrap_mode = 3

[node name="ChoiceRow" type="HFlowContainer" parent="Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2

[node name="StartButton" type="Button" parent="Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
focus_mode = 0
theme_type_variation = &"WaxButton"
text = "Start game"

[node name="Heading" type="Label" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
text = "Players"
clip_text = true
text_overrun_behavior = 3

[node name="RosterScroll" type="ScrollContainer" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PlayerRows" type="VBoxContainer" parent="Rows/RosterScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 3
