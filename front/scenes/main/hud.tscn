[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hud/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/hud/roster.gd" id="2_roster"]
[ext_resource type="Script" path="res://scripts/hud/phase_clock.gd" id="3_clock"]
[ext_resource type="Script" path="res://scripts/hud/chat_panel.gd" id="5_chat"]
[ext_resource type="Texture2D" path="res://assets/sprites/ui/will.png" id="6_will"]

[node name="Hud" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_hud")

[node name="Shell" type="AspectFlowContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 2.0
offset_top = 2.0
offset_right = -2.0
offset_bottom = -2.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Info" type="PanelContainer" parent="Shell"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

[node name="InfoBox" type="VBoxContainer" parent="Shell/Info"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="PhaseClock" type="PanelContainer" parent="Shell/Info/InfoBox"]
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_clock")

[node name="Rows" type="VBoxContainer" parent="Shell/Info/InfoBox/PhaseClock"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = -1

[node name="TitleRow" type="HBoxContainer" parent="Shell/Info/InfoBox/PhaseClock/Rows"]
layout_mode = 2
mouse_filter = 2
alignment = 1

[node name="Title" type="Label" parent="Shell/Info/InfoBox/PhaseClock/Rows/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudTitle"
text = "Lobby"

[node name="Time" type="Label" parent="Shell/Info/InfoBox/PhaseClock/Rows/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "0:00"

[node name="Stage" type="Label" parent="Shell/Info/InfoBox/PhaseClock/Rows"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
clip_text = true
text_overrun_behavior = 3

[node name="Middle" type="Control" parent="Shell"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2

[node name="WorldSpace" type="Control" parent="Shell/Middle"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="MinigameSpace" type="Control" parent="Shell/Middle/WorldSpace"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="ChatPanel" type="PanelContainer" parent="Shell/Info/InfoBox"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("5_chat")

[node name="Rows" type="VBoxContainer" parent="Shell/Info/InfoBox/ChatPanel"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Log" type="RichTextLabel" parent="Shell/Info/InfoBox/ChatPanel/Rows"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
theme_override_font_sizes/normal_font_size = 6
scroll_following = true

[node name="InputRow" type="HBoxContainer" parent="Shell/Info/InfoBox/ChatPanel/Rows"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Channel" type="Label" parent="Shell/Info/InfoBox/ChatPanel/Rows/InputRow"]
unique_name_in_owner = true
layout_mode = 2
text = "town"

[node name="Input" type="LineEdit" parent="Shell/Info/InfoBox/ChatPanel/Rows/InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Enter to chat"
max_length = 1600

[node name="SendButton" type="Button" parent="Shell/Info/InfoBox/ChatPanel/Rows/InputRow"]
layout_mode = 2
focus_mode = 0
text = "Send"

[node name="Side" type="VBoxContainer" parent="Shell"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Roster" type="PanelContainer" parent="Shell/Side"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("2_roster")

[node name="Rows" type="VBoxContainer" parent="Shell/Side/Roster"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Prompt" type="Label" parent="Shell/Side/Roster/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"HudTitle"
autowrap_mode = 3

[node name="ChoiceRow" type="HFlowContainer" parent="Shell/Side/Roster/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2

[node name="StartButton" type="Button" parent="Shell/Side/Roster/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 7
text = "Start game"

[node name="Heading" type="Label" parent="Shell/Side/Roster/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudHeading"
text = "Players"
clip_text = true
text_overrun_behavior = 3

[node name="RosterScroll" type="ScrollContainer" parent="Shell/Side/Roster/Rows"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PlayerRows" type="VBoxContainer" parent="Shell/Side/Roster/Rows/RosterScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 3

[node name="WillButton" type="Button" parent="Shell/Side"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 0
focus_mode = 0
tooltip_text = "Last will"
icon = ExtResource("6_will")


