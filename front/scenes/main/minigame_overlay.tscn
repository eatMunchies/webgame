[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/minigame/minigame_overlay.gd" id="1_script"]
[ext_resource type="Resource" path="res://skill_checks/wheel.tres" id="2_wheel"]
[ext_resource type="Script" path="res://scripts/minigame/skill_check_def.gd" id="3_def"]
[ext_resource type="Resource" path="res://skill_checks/typing.tres" id="4_typing"]
[ext_resource type="Resource" path="res://skill_checks/memory.tres" id="5_memory"]
[ext_resource type="Resource" path="res://skill_checks/flappy.tres" id="6_flappy"]
[ext_resource type="Resource" path="res://skill_checks/golf.tres" id="7_golf"]
[ext_resource type="Resource" path="res://skill_checks/fruit.tres" id="8_fruit"]
[ext_resource type="Resource" path="res://skill_checks/blackjack.tres" id="9_blackjack"]

[node name="MinigameOverlay" type="PanelContainer"]
anchor_left = 0.5
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -94.0
offset_top = 30.0
offset_right = 60.0
offset_bottom = -2.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
skill_checks = Array[ExtResource("3_def")]([ExtResource("2_wheel"), ExtResource("4_typing"), ExtResource("6_flappy"), ExtResource("7_golf"), ExtResource("8_fruit"), ExtResource("9_blackjack")])
practice_checks = Array[ExtResource("3_def")]([ExtResource("4_typing"), ExtResource("5_memory"), ExtResource("6_flappy"), ExtResource("7_golf"), ExtResource("8_fruit"), ExtResource("9_blackjack")])

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Header" type="HBoxContainer" parent="Rows"]
layout_mode = 2

[node name="Title" type="Label" parent="Rows/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Heading"
text = "Skill check"

[node name="TimeLeft" type="Label" parent="Rows/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Mono"
text = "0.0s"

[node name="Canvas" type="Control" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Result" type="Label" parent="Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Body"
horizontal_alignment = 1
autowrap_mode = 3

[node name="FightButtons" type="HBoxContainer" parent="Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 2

[node name="StrikeButton" type="Button" parent="Rows/FightButtons"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "strike (J)"

[node name="GrabButton" type="Button" parent="Rows/FightButtons"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "grab (K)"

[node name="GuardButton" type="Button" parent="Rows/FightButtons"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "guard (L)"

[connection signal="pressed" from="Rows/FightButtons/StrikeButton" to="." method="_on_strike_button_pressed"]
[connection signal="pressed" from="Rows/FightButtons/GrabButton" to="." method="_on_grab_button_pressed"]
[connection signal="button_down" from="Rows/FightButtons/GuardButton" to="." method="_on_guard_button_down"]
